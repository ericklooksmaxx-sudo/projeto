# Copy to .env and fill in. The real .env is git-ignored: never commit it.

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=your_bot_token_here
PREFIX=.

# --- Role IDs of your server -----------------------------------------------
OWNER_ROLE_ID=1564136124874621058
CEO_ROLE_ID=1564136354571362424
ADMIN_ROLE_ID=1564136202758524930
STAFF_ROLE_ID=1564136444610617364
MEMBER_ROLE_ID=1564136757761679511
PREMIUM_ROLE_ID=1564136656729153647

# --- Credits ---------------------------------------------------------------
DAILY_REGULAR_CREDITS=5
DAILY_STAFF_CREDITS=25
DAILY_ADMIN_CREDITS=50
DAILY_PREMIUM_CAP=100
COMMAND_COST=1

# --- AI assistant (optional) -----------------------------------------------
# OpenRouter free models are tried first, then NVIDIA NIM.
OPENROUTER=
NVIDIA_NIM=
# Overrides, comma-separated, strongest first:
# AI_OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free
# AI_NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b,mistralai/mistral-large-4-1t-a52b
# AI_REQUEST_TIMEOUT=120
# AI_TOTAL_TIMEOUT=180
# AI_MAX_TOKENS=1800

# --- Health-check server (optional) ----------------------------------------
# Answers GET / and GET /health with a small JSON status, for hosting platforms and uptime pings.
PORT=8080
HOST=0.0.0.0
ENABLE_WEB_SERVER=true

# --- Dumper tuning (optional) ----------------------------------------------
# DUMPER_TIMEOUT=120
# DUMPER_STALL_TIMEOUT=35
# DUMPER_MAX_BYTES=4194304
# LUNE_BIN=/path/to/lune
# DARKLUA_BIN=/path/to/darklua
